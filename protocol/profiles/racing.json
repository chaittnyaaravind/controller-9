    { "id": "shift-up", "type": "button", "bind": "rb", "x": 0.82, "y": 0.05, "w": 0.16, "h": 0.22, "label": "Shift +" },
    { "id": "handbrake", "type": "button", "bind": "a", "x": 0.62, "y": 0.6, "w": 0.17, "h": 0.32, "label": "E-brake" },
