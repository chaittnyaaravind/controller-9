<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into Controller-9.app/Contents/Info.plist by the Tauri bundler. macOS terminates an app that
     uses Bluetooth or the local network without these reasons (TCC). Documented in docs/platforms/macos.md. -->
<plist version="1.0">
<dict>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Connect to Controller-9 phones over Bluetooth when Wi-Fi is unavailable.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Find and talk to Controller-9 phones on your Wi-Fi network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_ninectl._tcp</string>
    </array>
</dict>
</plist>
