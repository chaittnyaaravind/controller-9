;
; NineVhf.inf — 9-controller virtual gamepad (KMDF HID source driver over VHF)
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ProviderName%
CatalogFile = NineVhf.cat
DriverVer   = 10/17/2026,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
NineVhf.sys = 1,,

[Manufacturer]
%ProviderName% = Nine,NTamd64.10.0...16299

[Nine.NTamd64.10.0...16299]
%DeviceDesc% = NineVhf_Inst, Root\NineVhf

[NineVhf_Inst.NT]
CopyFiles = NineVhf_CopyFiles

[NineVhf_CopyFiles]
NineVhf.sys

[NineVhf_Inst.NT.HW]
AddReg = NineVhf_HW_AddReg

[NineVhf_HW_AddReg]
; VHF must be the lower filter of a HID source driver.
HKR,,"LowerFilters",0x00010000,"vhf"
; SYSTEM and Administrators: full; interactive users: read/write (the host runs unelevated).
; Security note: any interactive process can create pads — equivalent to plugging in a gamepad.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[NineVhf_Inst.NT.Services]
AddService = NineVhf,0x00000002,NineVhf_Service

[NineVhf_Service]
DisplayName   = %ServiceName%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\NineVhf.sys

[NineVhf_Inst.NT.Wdf]
KmdfService = NineVhf, NineVhf_wdfsect

[NineVhf_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
ProviderName = "9-controller"
DiskName     = "9-controller driver disk"
DeviceDesc   = "9-controller virtual gamepad bus"
ServiceName  = "9-controller virtual gamepad"
